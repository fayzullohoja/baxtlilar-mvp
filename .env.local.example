## Postgres (Railway или локальный). На внешнем хосте добавь PGSSL=require.
DATABASE_URL=postgresql://user:pass@localhost:5432/baxtlilar
# PGSSL=require

## Объектное хранилище (фото/документы). На Railway — том /data, локально — ./.storage
STORAGE_DIR=.storage

## Сессия — 32+ случайных символа (openssl rand -base64 48)
SESSION_SECRET=change-me-to-32+chars-random

## Telegram bot (BotFather)
TELEGRAM_BOT_TOKEN=123456:AAH...
APP_URL=http://localhost:3000

## Bot username (без @) и short-name мини-аппы (из BotFather /newapp)
BOT_USERNAME=baxtlilar_uz_bot
BOT_WEBAPP_SHORT_NAME=app

## Секрет webhook'а (мин. 16 симв., передаётся в setWebhook secret_token).
## Сгенерировать: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=change-me-to-random-32-chars

## Канал поддержки (опц.) — показывается на тупиковых экранах
# SUPPORT_URL=https://t.me/baxtlilar_support

## Dev-only (НЕ ставить на prod!)
DEV_BYPASS_TG=1
